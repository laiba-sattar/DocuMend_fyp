# Copy this file to .env and fill it in. .env is never committed.

# Your Postgres connection string.
# Neon (free, no install): https://neon.tech → new project → "Connection string"
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Any long random text. Everyone's should be different.
# Make one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-something-long-and-random"

PORT=4000
CORS_ORIGIN="http://localhost:5173"
