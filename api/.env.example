# Copy this file to .env and fill it in. .env is never committed.

# Your Postgres connection string.
# Neon (free, no install): https://neon.tech → new project → "Connection string"
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Any long random text. Everyone's should be different.
# Make one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-something-long-and-random"

PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Sign in with Google / an email link (both go through Firebase).
# console.firebase.google.com → Project settings → Project ID.
# Only the project id is needed: ID tokens are checked against Google's public
# certificates, so there is no service-account key to keep safe.
FIREBASE_PROJECT_ID=""
