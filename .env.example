# Copy to .env.local for local development (Vite reads it automatically).
# Where the DocuMend API is. Docker and the cloud just point this somewhere else.
VITE_API_URL="http://localhost:4000"

# Sign in with Google and by email link — both go through Firebase.
# console.firebase.google.com → Project settings → Your apps → Web app.
# These four are public values (the project is protected by its authorized
# domains, and our server verifies every token).
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
